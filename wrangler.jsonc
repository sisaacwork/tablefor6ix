// Cloudflare Workers config. The git integration runs `npm run build` then
// `npx wrangler deploy`; this file makes that deploy non-interactive and
// deterministic. Static assets from dist/ plus one API route (worker/index.ts)
// that files restaurant submissions as GitHub issues.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tablefor6ix",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
